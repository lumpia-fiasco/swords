[{"type":"heading","html":"XLII. The Dwelling-places of Wisdom and of Unrighteousness.","kind":"sub"},{"type":"line","chapter":42,"verse":1,"html":"Wisdom found no place where she might dwell;","indent":1,"first":true},{"type":"line","chapter":42,"verse":1,"html":"Then a dwelling-place was assigned her in the heavens.","indent":1,"first":false},{"type":"line","chapter":42,"verse":2,"html":"Wisdom went forth to make her dwelling among the children of men,","indent":1,"first":true},{"type":"line","chapter":42,"verse":2,"html":"And found no dwelling-place:","indent":1,"first":false},{"type":"line","chapter":42,"verse":2,"html":"Wisdom returned to her place,","indent":1,"first":false},{"type":"line","chapter":42,"verse":2,"html":"And took her seat among the angels.","indent":1,"first":false},{"type":"line","chapter":42,"verse":3,"html":"And unrighteousness went forth from her chambers:","indent":1,"first":true},{"type":"line","chapter":42,"verse":3,"html":"Whom she sought not she found,","indent":1,"first":false},{"type":"line","chapter":42,"verse":3,"html":"And dwelt with them,","indent":1,"first":false},{"type":"line","chapter":42,"verse":3,"html":"As rain in a desert","indent":1,"first":false},{"type":"line","chapter":42,"verse":3,"html":"And dew on a thirsty land.","indent":1,"first":false}]